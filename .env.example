# Diisi OTOMATIS oleh integrasi Upstash Redis di Vercel (salah satu pasangan nama ini).
# Hanya perlu diisi manual bila ingin menguji Redis sungguhan dari komputermu.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# atau nama lama dari Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Jumlah pemain minimum sebelum Room Master bisa menekan MULAI (1–4, bawaan 4). Isi 2 untuk uji coba.
# MIN_PLAYERS=4

# --- TURN (relay) agar video layar pemain sampai ke Room Master di semua jaringan. ---
# Metered.ca (diprioritaskan). Dashboard Metered → TURN Server → salin nama domain & API Key.
METERED_DOMAIN=namaapp.metered.live
METERED_API_KEY=
# Cadangan (opsional, dipakai bila Metered gagal): Cloudflare Realtime TURN / coturn / TURN statis
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# TURN_URLS=turn:turn.contoh.com:3478,turns:turn.contoh.com:443?transport=tcp
# TURN_SECRET=            (coturn static-auth-secret)  atau  TURN_USERNAME= + TURN_CREDENTIAL=
